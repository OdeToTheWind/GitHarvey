# Required. At least 32 characters. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Optional. Your site address. Used for the social preview image and absolute links.
NEXT_PUBLIC_SITE_URL=https://githarvey.vercel.app

# Optional. Your public GitHub repo, as https://github.com/owner/repo. Shows the GitHub
# link in the navbar and the "View the source", "Report an issue" and "Host your own"
# links in the footer. Hidden when unset.
NEXT_PUBLIC_REPO_URL=https://github.com/OdeToTheWind/GitHarvey

# Required. Your GitHub OAuth app, for "Sign in with GitHub" (no scopes are requested).
# Create it at GitHub > Settings > Developer settings > OAuth Apps > New OAuth App, with the callback URL
#   http://localhost:3000/api/auth/github/callback   (local)
#   https://your-site/api/auth/github/callback       (live)
# Put the Client ID and a generated Client secret here (local) or in Vercel > Settings > Environment Variables (live).
# The secret stays on the server: never prefix it with NEXT_PUBLIC_.
GITHUB_CLIENT_ID=Ov23liMJG20CtS0yoxFy
GITHUB_CLIENT_SECRET=d2bab09efd1c7635443e6ae1e4d3ac08ad8d8e73
