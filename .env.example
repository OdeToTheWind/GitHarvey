# Required. At least 32 characters. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Optional. Default false. Lets visitors use the site without their own token
# (uses YOUR token's quota, so keep it off until you are ready for that).
ENABLE_FALLBACK=false
FALLBACK_GITHUB_TOKEN=

# Optional. Used for absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Your public GitHub repo. Shows "View the source", "Report an issue"
# and "Host your own" links in the footer. Must be a https://github.com/owner/repo URL.
NEXT_PUBLIC_REPO_URL=
