# Required. At least 32 characters. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Optional. Your site address. Used for the social preview image and absolute links.
NEXT_PUBLIC_SITE_URL=https://githarvey.vercel.app

# Optional. Your public GitHub repo, as https://github.com/owner/repo. Shows the GitHub
# link in the navbar and the "View the source", "Report an issue" and "Host your own"
# links in the footer. Hidden when unset.
NEXT_PUBLIC_REPO_URL=https://github.com/OdeToTheWind/GitHarvey
